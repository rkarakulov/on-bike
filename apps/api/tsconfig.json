{
  "extends": "@on-bike/config/tsconfig.library.json",
  // Только проверка типов (сборка — SWC в CommonJS). Пакеты базы @rkarakulov/* — ESM: с NodeNext tsc
  // берёт для кода api CJS-декларации drizzle-orm (.d.cts), а для деклараций api-kit — ESM (.d.ts), и
  // типы одной библиотеки не совместимы. Bundler — одни декларации (import) для всех; в рантайме
  // drizzle сопоставляет сущности по entityKind (Symbol.for), а не по классу.
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "outDir": "dist"
  },
  "include": ["src", "test", "drizzle.config.ts", "vitest.config.mts"]
}
