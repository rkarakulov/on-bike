{
  "name": "@on-bike/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS модульный монолит: HTTP API (main.ts) и воркер очередей (worker.ts)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@node-rs/argon2": "^2.2.2",
    "@on-bike/contracts": "workspace:*",
    "@on-bike/tracks": "workspace:*",
    "@rkarakulov/api-kit": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "jose": "^6.2.13",
    "nodemailer": "10.1.7",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "catalog:",
    "@on-bike/config": "workspace:*",
    "@rkarakulov/test-kit": "catalog:",
    "@swc/cli": "^0.8.0",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
