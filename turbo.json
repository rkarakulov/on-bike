{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:web": {
      "cache": false,
      "env": ["EXPO_PUBLIC_*"]
    },
    "e2e:web": {
      "dependsOn": ["build:web"],
      "cache": false,
      "env": ["EXPO_PUBLIC_*"],
      "passThroughEnv": [
        "CI",
        "PW_CHANNEL",
        "E2E_PORT",
        "E2E_DEV_PORT",
        "API_INTERNAL_URL",
        "E2E_API",
        "MAILPIT_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "env": ["DATABASE_URL_TEST", "REDIS_URL_TEST"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:worker": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
