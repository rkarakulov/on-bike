# Домены — заглушки, пока не зарегистрирован .by (см. смету)
{$PUBLIC_HOST:pokatim.localhost} {
	encode zstd gzip
	handle /v1/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:8080
	}
}

{$ADMIN_HOST:admin.pokatim.localhost} {
	encode zstd gzip
	handle /v1/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
